# swaylock-effects config — Catppuccin Mocha

# Background
image=~/.config/swaylock/wallpaper.png
scaling=fill

# Behavior
ignore-empty-password
show-failed-attempts
daemonize

# Effects (swaylock-effects only)
effect-blur=8x3
effect-vignette=0.5:0.5
fade-in=0.2
clock
timestr=%H:%M
datestr=%A, %d %B
font=Iosevka Nerd Font
font-size=16

# Indicator ring
indicator
indicator-radius=110
indicator-thickness=10
indicator-caps-lock

line-color=1e1e2e80
ring-color=19172400
inside-color=1e1e2ee0
key-hl-color=#89dceb
separator-color=00000000
text-color=e0def4
text-caps-lock-color=""
line-ver-color=#89dceb
ring-ver-color=#89dceb
inside-ver-color=1e1e2ee0
text-ver-color=e0def4
ring-wrong-color=38ba8
text-wrong-color=38ba8
inside-wrong-color=1e1e2ee0
inside-clear-color=1e1e2ee0
text-clear-color=e0def4
ring-clear-color=9ccfd8
line-clear-color=1e1e2e
line-wrong-color=1e1e2e
bs-hl-color=38ba8