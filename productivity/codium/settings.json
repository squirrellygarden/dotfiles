{
  "workbench.colorTheme": "Catppuccin Mocha",
  "workbench.iconTheme": "catppuccin-mocha",
  "ipynb.pasteImagesAsAttachments.enabled": false,
  "ipynb.experimental.serialization": false,
  "catppuccin.accentColor": "teal",
  "[python]": {
    "editor.defaultFormatter": "charliermarsh.ruff",
    "editor.formatOnSave": true
  },
  "[markdown]": {
    "editor.wordWrap": "wordWrapColumn",
    "editor.wordWrapColumn": 110
  },
  "git.confirmSync": false,
  "diffEditor.ignoreTrimWhitespace": false,
  "editor.accessibilitySupport": "off",
  "editor.acceptSuggestionOnEnter": "off",
  "python.experiments.optOutFrom": [
    "All"
  ],
  "python.REPL.enableREPLSmartSend": false,
  "npm.autoDetect": "off",
  "npm.fetchOnlinePackageInfo": false,
  "editor.codeLens": false,
  "editor.codeActionWidget.showHeaders": false,
  "editor.codeActionWidget.includeNearbyQuickFixes": false,
  "editor.multiCursorLimit": 1,
  "diffEditor.renderSideBySide": true,
  "editor.inlineSuggest.suppressSuggestions": true,
  "editor.acceptSuggestionOnCommitCharacter": false,
  "editor.wordBasedSuggestions": "off",
  "editor.wordWrapColumn": 8,
  "editor.unicodeHighlight.nonBasicASCII": false,
  "git.openRepositoryInParentFolders": "never",
  "files.exclude": {
    "__pycache__/": true,
    "**/__pycache__/": true,
    "**/.gitlab": true
  },
  "python.createEnvironment.trigger": "off",
  "todohighlight.include": [
    "**/*.js",
    "**/*.jsx",
    "**/*.ts",
    "**/*.tsx",
    "**/*.html",
    "**/*.php",
    "**/*.css",
    "**/*.scss",
    "**/*.c",
    "**/*.s",
    "**/*.S",
    "**/*.cpp",
    "**/*.h",
    "**/*.hpp",
    "**/*.py",
  ],
  "todohighlight.defaultStyle": {},
  "inlineChat.lineNaturalLanguageHint": false,
  "editor.inlayHints.enabled": "off",
  "ruff.lineLength": 120,
  "ruff.configuration": "",
  "ruff.lint.ignore": [
    "E501"
  ],
  "python.venvPath": "./.venv",
  "editor.fontFamily": "'Iosevka', 'Ubuntu Mono', monospace",
  "ilspy.autoLoadDependencies": true,
  "workbench.settings.showAISearchToggle": false,
  "chat.agentSessionsViewLocation": "view",
  "chat.extensionTools.enabled": false,
  "chat.promptFiles": false,
  "chat.sendElementsToChat.attachImages": false,
  "chat.sendElementsToChat.attachCSS": false,
  "chat.sendElementsToChat.enabled": false,
  "chat.todoListTool.descriptionField": false,
  "chat.showAgentSessionsViewDescription": false,
  "chat.tools.terminal.enableAutoApprove": false,
  "chat.useAgentsMdFile": false,
  "chat.detectParticipant.enabled": false,
  "security.workspace.trust.banner": "always",
  "telemetry.feedback.enabled": false,
  "python.REPL.provideVariables": false,
  "python.terminal.activateEnvironment": false,
  "python.terminal.shellIntegration.enabled": false,
  "python.testing.autoTestDiscoverOnSaveEnabled": false,
  "terminal.integrated.stickyScroll.enabled": false,
  "window.menuBarVisibility": "compact",
  "terminal.integrated.commandsToSkipShell": [
    "workbench.action.output.toggleOutput",
    "workbench.action.problems.focus"
  ],
  "editor.unicodeHighlight.ambiguousCharacters": false,
  "csv.clickableLinks": false,
  "github-authentication.useElectronFetch": false,
  "razor.languageServer.cohostingEnabled": false,
  "razor.format.codeBlockBraceOnNextLine": true,
  "editor.minimap.enabled": false,
}